DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DB_NAME=school_management_db
DB_USER=school_management_app
DB_PASSWORD=replace-with-the-development-password
DB_HOST=127.0.0.1
DB_PORT=5433

# Local application sessions and temporary login throttles, in seconds.
APP_SESSION_IDLE=1800
APP_SESSION_MAX=43200
APP_LOGIN_WINDOW=300
APP_LOGIN_LIMIT=8
APP_LOGIN_IP_LIMIT=60
# Enable only behind a trusted TLS proxy that overwrites X-Forwarded-Proto.
DJANGO_TRUST_PROXY_HTTPS=False

# Only the vendor's trusted public-key JSON goes on the customer server.
LICENSE_PUBLIC_KEYS_FILE=
LICENSE_MAX_GRACE_DAYS=7
LICENSE_GRACE_WRITES=False
LICENSE_CLOCK_TOLERANCE=300

# Private student attachments are normalized images with institution-defined categories.
STUDENT_DOCUMENT_KINDS=admission-form,academic-record,photo,transfer-certificate,other
STUDENT_DOCUMENT_MAX_BYTES=5242880
